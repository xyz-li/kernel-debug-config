{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kernel: Build and debug (automatic)",
      "type": "cppdbg",
      "request": "launch",
      "targetArchitecture": "arm64",
      "program": "/output/vmlinux",
      "cwd": "/kernel",
      "MIMode": "gdb",
      "preLaunchTask": "Kernel: Prepare debug VM",
      "launchCompleteCommand": "exec-continue",
      "pipeTransport": {
        "pipeProgram": "${workspaceFolder:kernel-config}/dev.sh",
        "pipeArgs": [
          "pipe"
        ],
        "debuggerPath": "/usr/bin/gdb-multiarch",
        "pipeCwd": "${workspaceFolder:kernel-config}",
        "pipeEnv": {
          "KERNEL_SOURCE": "${workspaceFolder:kernel-source}"
        },
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/cache/source": "${workspaceFolder:kernel-source}",
        "/cache/build": "${workspaceFolder:kernel-config}/output/generated",
        "/kernel": "${workspaceFolder:kernel-source}"
      },
      "setupCommands": [
        {
          "text": "set pagination off"
        }
      ],
      "postDebugTask": "Kernel: Stop debug VM",
      "customLaunchSetupCommands": [
        {
          "text": "-file-exec-and-symbols /output/vmlinux"
        },
        {
          "text": "-target-select remote /cache/run/gdb.sock"
        },
        {
          "text": "source /cache/build/vmlinux-gdb.py",
          "ignoreFailures": true
        },
        {
          "text": "-break-insert -h -f start_kernel"
        }
      ]
    },
    {
