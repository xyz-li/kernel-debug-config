#!/bin/sh
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /dev/shm /run /tmp /sys/kernel/debug /sys/kernel/tracing
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /dev/shm
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true
mount -t tracefs tracefs /sys/kernel/tracing 2>/dev/null || true
hostname kernel-debug
sysctl -w net.ipv4.ping_group_range='0 2147483647' >/dev/null 2>&1 || true
if ! /etc/kernel-debug/network; then
    echo 'Network configuration failed; root shell remains available. See /run/kernel-debug/network.status.' >&2
fi
printf '\nKERNEL_DEBUG_READY %s\n' "$(uname -r)"
printf 'Root shell on ttyAMA0; rootfs is recreated from the initramfs at each boot.\n'
