{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder:kernel-config}",
    "env": {
      "KERNEL_SOURCE": "${workspaceFolder:kernel-source}"
    }
  },
  "tasks": [
    {
      "label": "Kernel: Build OCI images",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "setup",
        "--force"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Kernel: Start build container",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "up"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Kernel: Build kernel",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "build"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Kernel: Full build",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "build"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Kernel: Prepare persistent rootfs",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "rootfs"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Kernel: Rebuild rootfs",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "rootfs",
        "--force"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Kernel: Prepare debug VM",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "debug"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Kernel: Start QEMU",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "start"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Kernel: Stop debug VM",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "stop"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Kernel: Stop build container",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "down"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Kernel: Guest console",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "console"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Kernel: Guest logs",
      "type": "process",
      "command": "${workspaceFolder:kernel-config}/dev.sh",
      "args": [
        "logs"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    }
  ]
}
