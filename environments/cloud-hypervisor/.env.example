# Trusted Bash config, read on macOS and Linux. CLI environment wins with :-.
MACHINE=${MACHINE:-fc-ubuntu}
# CH_SOURCE=/absolute/path/to/cloud-hypervisor
# WORKDIR=${WORKDIR:-/var/tmp/ch-debug-config}
# TOOLS_DIR=${TOOLS_DIR:-/var/tmp/sandbox-debug-tools}
GUEST_MODE=${GUEST_MODE:-serial}  # serial or ssh; dev.sh --mode overrides this
CH_RUST_VERSION=${CH_RUST_VERSION:-stable}
JOBS=${JOBS:-2}
# Reuse only FC's base Ubuntu raw ext4 filesystem, never rootfs-run.ext4.
BASE_ROOTFS=${BASE_ROOTFS:-/var/tmp/fc-debug-config/rootfs.ext4}
# KERNEL=/absolute/Linux/path/to/arch/arm64/boot/Image
# VMLINUX=/absolute/Linux/path/to/matching/vmlinux
# Missing KERNEL is downloaded from CH's official Linux release, with SHA256.
# Override KERNEL_URL and KERNEL_SHA256 together for another release.
TAP_DEV=${TAP_DEV:-ch-debug0}
HOST_IP=${HOST_IP:-172.16.52.1}
GUEST_IP=${GUEST_IP:-172.16.52.2}
VCPUS=${VCPUS:-2}
MEMORY_MIB=${MEMORY_MIB:-512}
ENABLE_NETWORK=${ENABLE_NETWORK:-1}
ENABLE_NAT=${ENABLE_NAT:-1}
DNS_SERVER=${DNS_SERVER:-1.1.1.1}
DNS_SECONDARY=${DNS_SECONDARY:-8.8.8.8}
SSH_PORT=${SSH_PORT:-22}
# SSH_IDENTITY=/absolute/Linux/path/to/dedicated/unlocked_ed25519_key
# Development default: disable seccomp so debugger-related syscalls work.
SECCOMP=${SECCOMP:-false}
