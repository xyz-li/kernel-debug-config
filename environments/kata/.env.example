MACHINE=${MACHINE:-fc-ubuntu}
# SOURCE_DIR=/path/to/kata-containers
WORKDIR=${WORKDIR:-/var/tmp/kata-debug}
# Normally read from your checkout's rust-toolchain.toml:
# KATA_RUST_VERSION=1.96
# Full VM mode requires matching upstream Kata Guest/VMM assets.
# On Hosts without /dev/vhost-vsock, prefer Firecracker/Cloud Hypervisor.
# KATA_CONFIG=/path/to/rendered-configuration.toml
KATA_BUNDLE=${KATA_BUNDLE:-/var/tmp/kata-debug/bundle}
KATA_AGENT_SERVER_ADDR=${KATA_AGENT_SERVER_ADDR:-unix://@/tmp/kata-debug-agent.socket}
