# 最小化可调试内核配置
# 适用于 QEMU/KVM 虚拟化环境
# 包含: VirtIO 网络, VirtIO 块设备, 网络栈, 调试支持

# ============================================
# 核心系统配置
# ============================================
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_SCHED_MC=y

# 嵌入式系统优化
CONFIG_EMBEDDED=y
CONFIG_EXPERT=y

# 命名空间支持 (容器、网络隔离等需要)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y            # UTS 命名空间 (hostname)
CONFIG_IPC_NS=y            # IPC 命名空间
CONFIG_PID_NS=y            # PID 命名空间
CONFIG_NET_NS=y            # 网络命名空间 (veth 必需!)
CONFIG_USER_NS=y           # 用户命名空间

# ============================================
# 调试支持 (关键!)
# ============================================
# 调试信息格式和级别
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_REDUCED=n         # 不要减少调试信息
CONFIG_DEBUG_INFO_COMPRESSED=n      # 不压缩调试信息（便于 GDB 读取）
CONFIG_DEBUG_INFO_SPLIT=n           # 不分离调试信息
# CONFIG_DEBUG_INFO_NONE is not set  # 确保不禁用调试信息

# GDB 支持
CONFIG_GDB_SCRIPTS=y                # 生成 GDB Python 脚本
CONFIG_DEBUG_KERNEL=y

# 帧指针和符号表
CONFIG_FRAME_POINTER=y              # 保留帧指针（方便回溯）
CONFIG_KALLSYMS=y                   # 内核符号表
CONFIG_KALLSYMS_ALL=y               # 包含所有符号（包括未导出的）
CONFIG_KALLSYMS_ABSOLUTE_PERCPU=y   # Per-CPU 变量的绝对地址
CONFIG_KALLSYMS_BASE_RELATIVE=y     # 使用相对地址节省空间

# 调试和诊断工具
CONFIG_MAGIC_SYSRQ=y                # Magic SysRq 键
CONFIG_KGDB=y                       # 内核 GDB 支持
CONFIG_KGDB_SERIAL_CONSOLE=y        # 通过串口使用 KGDB

# 栈展开支持（ARM64）
CONFIG_UNWINDER_FRAME_POINTER=y     # 使用帧指针展开（更可靠）

# 提高汇编代码可读性
CONFIG_READABLE_ASM=y               # 生成更易读的汇编代码

# 其他有用的调试选项
CONFIG_DEBUG_FS=y                   # debugfs 文件系统
CONFIG_STACKTRACE=y                 # 栈跟踪支持
CONFIG_DEBUG_BUGVERBOSE=y           # 详细的 BUG 报告

# ============================================
# 总线支持
# ============================================
# PCI 支持（大部分网卡和设备需要）
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEASPM=y

# ARM PCI Host Controller (QEMU virt 机器必需!)
CONFIG_PCI_HOST_GENERIC=y

# ============================================
# 虚拟化支持 (VirtIO 必需)
# ============================================
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y

# ============================================
# VirtIO 核心 (必需!)
# ============================================
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_RING=y

# VirtIO 块设备 (必需!)
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_BLK_SCSI=y

# VirtIO 网络 (必需!)
CONFIG_VIRTIO_NET=y

# VirtIO 其他设备 (可选但推荐)
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y

# ============================================
# 网络支持 (必需!)
# ============================================
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
# CONFIG_NET_IPIP is not set        # 禁用 IPIP 隧道（避免创建 tunl0）
CONFIG_SYN_COOKIES=y
# CONFIG_INET_TUNNEL is not set     # 禁用通用隧道支持

# IPv6 支持
CONFIG_IPV6=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
# CONFIG_IPV6_SIT is not set         # 禁用 IPv6-in-IPv4 隧道（避免创建 sit0）

# ============================================
# Netfilter/iptables 支持 (必需!)
# ============================================
# 核心 Netfilter 框架（必须内建）
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_INGRESS=y
CONFIG_NETFILTER_NETLINK=y

# nf_tables (现代 iptables 1.8.x 后端) - 核心功能内建
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y


# nf_tables 扩展 - 作为模块
CONFIG_NFT_COMPAT=m
CONFIG_NFT_META=m
CONFIG_NFT_CT=m
CONFIG_NFT_COUNTER=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m

# 连接跟踪 (NAT 和状态检测必需) - 核心内建，扩展为模块
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y
CONFIG_NF_CONNTRACK_LABELS=y
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_IRC=m
CONFIG_NF_CONNTRACK_BROADCAST=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NF_CT_NETLINK_TIMEOUT=m
CONFIG_NF_CT_NETLINK_HELPER=m

# NAT 支持 - 核心内建
CONFIG_NF_NAT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_NAT_MASQUERADE=y

# IPv4 Netfilter 配置 - 核心内建，扩展为模块
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_CHAIN_ROUTE_IPV4=m
CONFIG_NF_REJECT_IPV4=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_ARPTABLES=m
CONFIG_IP_NF_ARPFILTER=m
CONFIG_IP_NF_ARP_MANGLE=m

# IPv6 Netfilter 配置 - 作为模块
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CHAIN_ROUTE_IPV6=m
CONFIG_NF_REJECT_IPV6=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m

# Netfilter Xtables (通用匹配和目标) - 核心内建，扩展为模块
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_SET=m
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_TARGET_MARK=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MAC=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_POLICY=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_STRING=m
CONFIG_NETFILTER_XT_MATCH_TCP=m
CONFIG_NETFILTER_XT_MATCH_UDP=m

# IP Set 支持 (ipset 命令需要) - 核心内建，类型为模块
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=256
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_IPPORTIP=m
CONFIG_IP_SET_HASH_IPPORTNET=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_HASH_NETIFACE=m
CONFIG_IP_SET_LIST_SET=m
CONFIG_IP_SET_BITMAP_IP=m
CONFIG_IP_SET_BITMAP_IPMAC=m
CONFIG_IP_SET_BITMAP_PORT=m

# 网络设备
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y

# 虚拟网络设备 (容器、网络命名空间等需要)
CONFIG_VETH=y              # Virtual Ethernet Pair (veth pair)
CONFIG_DUMMY=y             # Dummy 网络接口
CONFIG_TUN=y               # TUN/TAP 设备支持
CONFIG_VLAN_8021Q=y        # 802.1Q VLAN 支持
CONFIG_BRIDGE=y            # 网桥支持

# MII（Media Independent Interface）支持 - 很多以太网驱动的依赖
CONFIG_MII=y
CONFIG_PHYLIB=y

# Intel 网卡驱动（常见虚拟机和物理机网卡）- 作为模块
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=m          # Intel PRO/1000 千兆网卡（QEMU 常用）
CONFIG_E1000E=m         # Intel PRO/1000 PCIe 网卡
CONFIG_IGB=m            # Intel I350/I210/I211 网卡
CONFIG_IGBVF=m          # Intel I350 虚拟功能
# CONFIG_IXGB=m           # Intel PRO/10GbE
# CONFIG_IXGBE=m          # Intel 10 Gigabit PCI Express

# ============================================
# 块设备支持
# ============================================
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y

# ============================================
# 文件系统 (最小集合)
# ============================================
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y

# 临时文件系统
CONFIG_PROC_FS=y
CONFIG_PROC_KCORE=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# 初始化 RAM 磁盘
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=y
CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
CONFIG_RD_LZO=y
CONFIG_RD_LZ4=y

# ============================================
# TTY 和控制台
# ============================================
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n

# ARM PL011 串口 (ARM virt 机器使用，对应 ttyAMA0)
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# 8250 串口
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# VirtIO 控制台
CONFIG_HVC_DRIVER=y
CONFIG_VIRTIO_CONSOLE=y

# ============================================
# 可执行文件格式
# ============================================
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# ============================================
# 模块支持
# ============================================
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=y

# ============================================
# 禁用不需要的功能 (减小内核大小)
# ============================================
# 显卡和音频
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set

# 无线和蓝牙
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_BT is not set

# USB 支持已在上面启用（用于 USB 网卡）
# 注意：不要禁用 CONFIG_USB_SUPPORT

# 触摸屏和输入设备
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_JOYSTICK is not set

# SCSI (如果只用 VirtIO)
# CONFIG_SCSI is not set

# 其他硬件
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set

# ============================================
# 性能和调度
# ============================================
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y

# ============================================
# 打印和日志
# ============================================
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=4

# ============================================
# 安全 (最小化)
# ============================================
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_APPARMOR is not set
