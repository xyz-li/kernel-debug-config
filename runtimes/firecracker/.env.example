# Local shell configuration, loaded both on macOS and inside Linux.
MACHINE=${MACHINE:-fc-ubuntu}
# Guest control: liquidmetal (default), serial (no Agent), ssh (key-only, no Agent).
GUEST_MODE=${GUEST_MODE:-liquidmetal}
HOST_IMAGE=${HOST_IMAGE:-fc-debug-host:ubuntu24.04}
# HOST_KERNEL=/path/to/sources/containerization/kernel/vmlinux-arm64
ARTIFACT_MACHINE=${ARTIFACT_MACHINE:-}
# Source directories are shared into the Apple Container machine at the same path.
# FC_SOURCE=/path/to/sources/firecracker
# AGENT_SOURCE=/path/to/sources/guest-agent
WORKDIR=${WORKDIR:-/var/tmp/fc-debug-config}
# EXISTING_LAB=/path/to/sources/kernel-debug-config/runtimes/firecracker/output/import
# setup imports the existing release as bin/firecracker-release.
# build creates bin/firecracker-debug; run/debug default to that build.
# FC_BIN=/path/to/sources/kernel-debug-config/runtimes/firecracker/bin/firecracker-release
TAP_DEV=${TAP_DEV:-fc-debug0}
HOST_IP=${HOST_IP:-172.16.51.1}
GUEST_IP=${GUEST_IP:-172.16.51.2}
PREFIX=${PREFIX:-30}
GUEST_MAC=${GUEST_MAC:-06:00:ac:10:33:02}
ENABLE_NETWORK=${ENABLE_NETWORK:-1}
ENABLE_NAT=${ENABLE_NAT:-1}
DNS_SERVER=${DNS_SERVER:-1.1.1.1}
DNS_SECONDARY=${DNS_SECONDARY:-8.8.8.8}
VCPUS=${VCPUS:-2}
MEMORY_MIB=${MEMORY_MIB:-512}
SSH_PORT=${SSH_PORT:-22}
# SSH_IDENTITY=/path/to/dedicated/debug-key
# By default SSH mode creates its own key pair inside WORKDIR/ssh/ on Linux.
# For guest kernel debugging use Image + the matching vmlinux from one build:
# KERNEL=/path/to/output/Image
# VMLINUX=/path/to/output/vmlinux
