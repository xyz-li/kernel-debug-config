    {
      "name": "FC: Remote attach to Ubuntu Host (macOS)",
      "type": "cppdbg",
      "request": "attach",
      "targetArchitecture": "arm64",
      "program": "${workspaceFolder}/bin/firecracker-debug",
      "processId": "${input:fcPid}",
      "MIMode": "gdb",
      "cwd": "${workspaceFolder}",
      "pipeTransport": {
        "pipeProgram": "${workspaceFolder}/gdb-pipe.sh",
        "pipeArgs": [],
        "debuggerPath": "/usr/bin/gdb",
        "quoteArgs": false
      },
      "setupCommands": [
        {
          "text": "set pagination off"
        },
        {
          "text": "handle SIG35 nostop noprint pass"
        },
        {
          "text": "set print pretty on"
        }
      ]
    },
    {
      "name": "FC: Attach locally (Linux)",
      "type": "cppdbg",
      "request": "attach",
      "targetArchitecture": "arm64",
      "program": "${workspaceFolder}/bin/firecracker-debug",
      "processId": "${input:fcPid}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "cwd": "${workspaceFolder}",
      "setupCommands": [
        {
          "text": "set pagination off"
        },
        {
          "text": "handle SIG35 nostop noprint pass"
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "fcPid",
      "type": "promptString",
      "description": "Linux Firecracker PID printed by ./dev.sh run (not its macOS wrapper PID)"
    }
  ]
}
