{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FC: Launch on Ubuntu Host (macOS)",
      "preLaunchTask": "FC: Build",
      "type": "cppdbg",
      "request": "launch",
      "targetArchitecture": "arm64",
      "program": "${workspaceFolder}/bin/firecracker-debug",
      "args": [
        "--id",
        "fc-debug-config",
        "--api-sock",
        "/var/tmp/fc-debug-config/api.socket",
        "--config-file",
        "/var/tmp/fc-debug-config/config.json",
        "--level",
        "Debug"
      ],
      "MIMode": "gdb",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "pipeTransport": {
        "pipeProgram": "${workspaceFolder}/gdb-pipe.sh",
        "pipeArgs": [
          "--guest-mode",
          "liquidmetal"
        ],
        "debuggerPath": "${workspaceFolder}/gdb-host.sh",
        "quoteArgs": false
      },
      "setupCommands": [
        {
          "text": "set pagination off"
        },
        {
          "text": "handle SIG35 nostop noprint pass",
          "description": "Pass musl SIGRTMIN used to kick Firecracker vCPUs"
        },
        {
          "text": "set breakpoint pending on"
        },
        {
          "text": "-break-insert -f firecracker::main",
          "ignoreFailures": false
        }
      ]
    },
