{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gVisor: Setup",
      "type": "shell",
      "command": "./dev.sh setup",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "gVisor: Build",
      "type": "shell",
      "command": "./dev.sh build",
      "group": "build",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "gVisor: Doctor",
      "type": "shell",
      "command": "./dev.sh doctor",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "gVisor: Start Delve DAP",
      "type": "shell",
      "command": "./dev.sh dap",
      "isBackground": true,
      "problemMatcher": {
        "owner": "gvisor-dap",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error: .+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^DAP bridge listening at ",
          "endsPattern": "^DAP server listening at: "
        }
      },
      "presentation": {
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "gVisor: Attach Linux process",
      "type": "process",
      "command": "./dev.sh",
      "args": ["attach", "${input:linuxPid}"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "gvisor-attach",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error: .+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^DAP bridge listening at ",
          "endsPattern": "^API server listening at: "
        }
      },
      "presentation": {
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "gVisor: Prepare launch",
      "dependsOrder": "sequence",
      "dependsOn": ["gVisor: Build", "gVisor: Start Delve DAP"],
      "problemMatcher": []
    },
    {
      "label": "gVisor: List sandbox PIDs",
      "type": "shell",
      "command": "./dev.sh ps",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ],
  "inputs": [
    {
      "id": "linuxPid",
      "type": "promptString",
      "description": "Linux Sentry/Gofer PID from ./dev.sh ps"
    }
  ]
}
