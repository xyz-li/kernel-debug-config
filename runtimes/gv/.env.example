MACHINE=${MACHINE:-fc-ubuntu}
# SOURCE_DIR=/path/to/gvisor
WORKDIR=${WORKDIR:-/var/tmp/gvisor-debug}
DEBUG_PORT=${DEBUG_PORT:-38697}
GO_VERSION=${GO_VERSION:-1.26.2}
# Pin tool versions here after your first successful setup if reproducibility is needed.
DLV_VERSION=${DLV_VERSION:-latest}
BAZELISK_VERSION=${BAZELISK_VERSION:-latest}
