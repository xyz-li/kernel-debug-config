{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CH: Launch serial on Ubuntu Host (macOS)",
      "preLaunchTask": "CH: Build",
      "type": "cppdbg",
      "request": "launch",
      "targetArchitecture": "arm64",
      "program": "${workspaceFolder}/bin/cloud-hypervisor-debug",
      "args": [],
      "MIMode": "gdb",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "pipeTransport": {
        "pipeProgram": "${workspaceFolder}/gdb-pipe.sh",
        "pipeArgs": [
          "--guest-mode",
          "serial"
        ],
        "debuggerPath": "${workspaceFolder}/gdb-host.sh",
        "quoteArgs": false
      },
      "setupCommands": [
        {
          "text": "set pagination off"
        },
        {
          "text": "handle SIG34 nostop noprint pass",
          "description": "Pass glibc SIGRTMIN used to kick CH vCPUs"
        },
        {
          "text": "set breakpoint pending on"
        },
        {
          "text": "-break-insert -f cloud_hypervisor::main",
          "ignoreFailures": false
        }
      ],
      "sourceFileMap": {
        "/src/cloud-hypervisor": "${workspaceFolder:cloud-hypervisor-source}"
      }
    },
