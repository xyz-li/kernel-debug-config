.DS_Store
.claude
**/debug.local.code-workspace
**/__pycache__/

# Local runtime settings, source checkouts and build artifacts.
runtimes/*/.env
runtimes/*/.env.*
!runtimes/*/.env.example
runtimes/*/output/
runtimes/*/bin/*
!runtimes/fc/bin/.gitkeep

# Kernel sources, filesystem images and generated workspaces.
kernel/*/output/
kernel/output/

# Keep old local state private until tools/migrate_layout.py has moved it.
environments/*/.env
environments/*/.env.*
environments/*/bin/
environments/*/output/
one_container/output/
multi_containers/output/

# Private network lab kubeconfigs, generated topology state and old image archives.
network/cilium/*/output/
network/cilium/*/clab-*/
network/cilium/*/cilium-image.tar
